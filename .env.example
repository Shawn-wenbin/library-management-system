# 复制为 .env 后填写独立的本地口令；请勿提交 .env。
MYSQL_DATABASE=library
MYSQL_USER=library
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
# URL 中的特殊字符须百分号编码，使用与上方一致的账号密码。
DATABASE_URL=mysql+asyncmy://library:CHANGE_ME@127.0.0.1:3306/library?charset=utf8mb4
# 使用 python -c 'import secrets; print(secrets.token_urlsafe(48))' 生成。
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
LOG_LEVEL=INFO
# 管理员初始化时可填写；密码也可在终端安全输入。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 独立测试服务；只使用专用库，名称必须以 _test 结尾。
MYSQL_TEST_PASSWORD=
MYSQL_TEST_ROOT_PASSWORD=
MYSQL_TEST_PORT=3307
# TEST_DATABASE_URL=mysql+asyncmy://library_test:ENCODED_PASSWORD@127.0.0.1:3307/library_test?charset=utf8mb4
